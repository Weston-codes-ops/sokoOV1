# Copy this file to .env for local Docker development. Never commit .env.
POSTGRES_DB=sokoonline
POSTGRES_USER=sokoonline
POSTGRES_PASSWORD=change-this-local-password

# Use a long random value in every real environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters
JWT_ISSUER=sokoonline-api
JWT_AUDIENCE=sokoonline-web

# Comma-separated origin patterns accepted by the API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173